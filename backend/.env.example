NODE_ENV=development
PORT=5000
HOST=0.0.0.0
MONGODB_URI=mongodb://localhost:27017/yrstream

# Storage Provider: 'local' (development) or 'google_drive' (production cloud)
STORAGE_PROVIDER=local

# Google Drive Configuration (Required when STORAGE_PROVIDER=google_drive)
# Option A: OAuth2 (Recommended for Personal Google Drive)
GOOGLE_DRIVE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your_google_client_secret
GOOGLE_DRIVE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_DRIVE_REDIRECT_URI=https://developers.google.com/oauthplayground

# Option B: Service Account (Recommended for Google Workspace / Shared Drives)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: Specific Root Folder ID in Google Drive (Leave blank to auto-create 'YR-STREAM')
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_drive_folder_id_here

# Concurrency for background video processing worker
MEDIA_WORKER_CONCURRENCY=1

# Local Temporary Working Directory for FFmpeg
TEMP_MEDIA_PATH=./storage/temp

# Local Storage Paths (Used when STORAGE_PROVIDER=local)
STORAGE_PATH=../storage
VIDEO_STORAGE_PATH=../storage/movies
THUMBNAIL_STORAGE_PATH=../storage/thumbnails
SUBTITLE_STORAGE_PATH=../storage/subtitles
TRANSCODE_STORAGE_PATH=../storage/transcoded
HLS_STORAGE_PATH=../storage/hls

# Frontend
FRONTEND_URL=http://localhost:3000

